# ==============================================================================
# PORTFOLIO CMS - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Petunjuk:
# 1. Salin file ini menjadi `.env` di root direktori untuk pengembangan lokal:
#    cp .env.example .env
# 2. Untuk deployment ke Vercel / Cloud Provider, masukkan variabel-variabel ini
#    di menu Settings -> Environment Variables pada platform hosting Anda.
# 3. JANGAN PERNAH menyertakan secret key atau password asli ke dalam file repositori Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Mode lingkungan kerja: 'development' | 'production' | 'test'
NODE_ENV=development

# Port untuk server API backend lokal (default: 3001)
PORT=3001

# URL publik backend API (digunakan untuk CORS & redirect)
APP_URL=http://localhost:3001

# URL domain frontend client (digunakan untuk validasi CORS credentials)
FRONTEND_URL=http://localhost:5173

# Optional: Override base URL API di frontend client (kosongkan jika relative path /api)
# VITE_API_URL=http://localhost:3001/api/v1

# ------------------------------------------------------------------------------
# 2. TURSO / LIBSQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Untuk lokal: gunakan file SQLite lokal 'file:local.db'
# Untuk production: gunakan URL database Turso Anda, contoh:
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_URL=file:local.db

# Token otorisasi Turso (kosongkan untuk SQLite lokal, wajib untuk Turso production)
# Dapatkan token dengan: turso db tokens create <database-name>
DATABASE_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret string acak dengan entropi tinggi untuk enkripsi & proteksi sesi admin
# Minimal 32 karakter (dapat digenerate via `openssl rand -hex 32`)
SESSION_SECRET=super_secret_session_key_replace_this_in_production_min_32_chars

# Secret untuk verifikasi inisialisasi awal admin bootstrap
ADMIN_BOOTSTRAP_SECRET=bootstrap_secret_token_replace_me

# Default Kredensial Admin Awal (Digunakan saat menjalankan `npm run db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345!
ADMIN_USERNAME=admin

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA STORAGE & CDN
# ------------------------------------------------------------------------------
# Dapatkan dari Cloudinary Console Dashboard (https://console.cloudinary.com)
# Digunakan oleh backend untuk membuat upload signature aman dan menghapus asset.
# CATATAN: Kredensial ini hanya di server dan TIDAK PERNAH dikirim ke browser!
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
